rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Certificate images uploaded from the Admin Panel.
    // Public can view them (they appear on the live site); only the admin account can upload/replace/delete.
    match /certificates/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "CKk7ndnDPSM9LqBA1GuOth0nL6E2";
    }
  }
}
